# Copy to .env on the droplet (provision-site seeds the file with PORT; add
# the rest to it with an editor — never echo a key on a command line).
# app.py reads .env ONCE at startup: after editing it, run `droids restart`.

# Must match the vhost's proxy_pass and DROIDS_PORT in bin/droids.
PORT=8075

# The only secret. Spent by POST /api/chat; never sent to the browser.
ANTHROPIC_API_KEY=

# Optional. The model both droids use. Default: claude-opus-5-5.
#DROIDS_MODEL=claude-opus-5-5

# Optional. The page is public and unauthenticated, so these bound the spend.
# One droid line = one model call.
#DROIDS_RATE_PER_MIN=20       # per client IP
#DROIDS_RATE_PER_DAY=300      # per client IP
#DROIDS_GLOBAL_PER_DAY=3000   # whole site
