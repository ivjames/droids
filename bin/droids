#!/usr/bin/env bash
# droids — operate CLI for droids.lab980.com (Droid Talk).
#
# A proxied app site: nginx fronts a pm2-managed gunicorn (Python/Flask)
# process on 127.0.0.1:8075, which serves the static page and the /api proxy.
# Bring-up is `provision-site` (see lab980's CLAUDE.md); this script owns
# everything after that:
#
#   droids deploy    git pull -> venv + pip install -> pm2 start/restart -> probe -> save
#   droids restart   pm2 restart + probe, no code change
#   droids logs      tail the pm2 logs for this app
#   droids status    HEAD, pm2 state, local + public probe, key, mic policy, cert days
#   droids mic       let this one vhost use the microphone (see cmd_mic)
#
# Env overrides:
#   DROIDS_FQDN          default droids.lab980.com
#   DROIDS_BRANCH        default main
#   DROIDS_PORT          default 8075
#   DROIDS_PROBE_TRIES   default 10 (one second apart)
#
# The app dir is wherever this script's checkout lives (normally
# /var/www/droids) — derived from the script's own path, so the
# /usr/local/bin symlink resolves back here.
set -euo pipefail

SELF="$(readlink -f "$0")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
FQDN="${DROIDS_FQDN:-droids.lab980.com}"
BRANCH="${DROIDS_BRANCH:-main}"
PORT="${DROIDS_PORT:-8075}"
PROBE_TRIES="${DROIDS_PROBE_TRIES:-10}"
APP="droids"

# The `pm2 start` argv that registers this app the FIRST time. Every later
# deploy is a `pm2 restart $APP` of that registration, so a change here only
# takes effect after `pm2 delete droids` + `droids deploy`.
#
#   --interpreter none   gunicorn is the venv's own executable, not a script
#                        for pm2 to hand to node.
#   --exp-backoff-…      a startup that fails (bad .env, port taken) backs off
#                        1s, 2s, 4s… instead of relaunching several times a
#                        second while pm2 reports "online".
#   --workers 1          NOT a tuning knob. The rate limits that bound what
#                        this public endpoint can spend are counters in the
#                        process's memory; a second worker is a second set of
#                        counters and silently doubles every limit. Threads
#                        give the concurrency.
#   --no-control-socket  gunicorn otherwise opens ~/.gunicorn/gunicorn.ctl,
#                        one path shared by every gunicorn root runs.
# The process gets PORT from pm2_clean below and everything else from .env,
# which app.py reads itself at startup.
START_CMD=(.venv/bin/gunicorn --name "$APP" --interpreter none
           --exp-backoff-restart-delay=1000 --
           --bind "127.0.0.1:$PORT" --workers 1 --threads 8 --timeout 60
           --no-control-socket app:app)

MIC_SNIPPET="/etc/nginx/snippets/droids-permissions-microphone.conf"
BASE_INCLUDE="snippets/lab980-security-headers.conf"

c_blue=$'\033[1;34m'; c_yellow=$'\033[1;33m'; c_red=$'\033[1;31m'; c_off=$'\033[0m'
log()  { printf '%s==>%s %s\n' "$c_blue" "$c_off" "$*"; }
warn() { printf '%swarn:%s %s\n' "$c_yellow" "$c_off" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$c_red" "$c_off" "$*" >&2; exit 1; }

usage() {
  cat <<'USAGE'
droids — operate droids.lab980.com (pm2 app behind nginx).

Usage:
  droids deploy                pull, venv + pip install, pm2 start/restart, probe, save
  droids restart               pm2 restart + probe (needed after editing .env)
  droids logs [-n N]           tail pm2 logs
  droids status                HEAD + pm2 + local/public probe + key + mic policy + cert
  droids mic [--remove] [--dry-run]
                               allow the microphone on this vhost (nginx), or undo it

Env: DROIDS_FQDN, DROIDS_BRANCH (default main), DROIDS_PORT (default 8075),
     DROIDS_PROBE_TRIES (default 10).
USAGE
}

# The app runs as root under pm2, and pm2 keeps one daemon, process list and
# dump PER HOME — root's is /root/.pm2. Run as anyone else, or as uid 0 with
# someone else's HOME (`su root` without `-`, `sudo` preserving HOME), and
# every pm2 call here talks to a different daemon: `status` says "not
# registered" while the site is up, and `deploy` starts a second copy.
need_root() {
  [ "$(id -u)" -eq 0 ] || die "$1 must run as root (the app's pm2 daemon is root's)."
  local rhome; rhome="$(getent passwd root | cut -d: -f6)"
  [ -n "${PM2_HOME:-}" ] || [ "${HOME:-}" = "$rhome" ] \
    || die "$1: HOME is '${HOME:-}' but root's home is $rhome — pm2 keys its daemon and dump off HOME, so this would talk to a different pm2. Use \`sudo -i\` or \`su -\` (or set PM2_HOME on purpose)."
}

# ---------------------------------------------------------------------------
# pm2. Every pm2 call goes through pm2_clean, which launches it from an EMPTY
# environment plus the handful of variables pm2 itself needs and PORT. pm2
# copies the environment of the `pm2 start` call into the process, and from
# there into ~/.pm2/dump.pm2 on save — so a plain `pm2 start` (or `pm2
# restart --update-env`, which re-captures the shell on every deploy) gives
# whatever the calling shell holds — a key exported for one command, a
# token — an indefinite on-disk lifetime in the dump. (Until 2026-09-05 a
# root login shell here carried every platform key from /etc/environment;
# it holds none now, and there is no box-level key store.) The daemon
# itself keeps the environment of whichever call first spawned it (visible in
# its /proc/<pid>/environ for as long as it runs; the processes it starts do
# NOT inherit it), which is why jlist and logs go through here as well.
#
# PORT is handed in because provision-site chose it, this script knows it, it
# is not a secret, and an app started from `env -i` would otherwise have no
# port. Everything else the app needs comes from its own `.env` (dotenv, or
# an ecosystem file that reads it) — never from the shell that ran this
# script. A variable the app needs but does not read from `.env` is an app
# change, not an argument to pass here.
# ---------------------------------------------------------------------------
pm2_clean() {
  env -i PATH="$PATH" HOME="$HOME" ${PM2_HOME:+PM2_HOME="$PM2_HOME"} \
    ${TERM:+TERM="$TERM"} LANG=C.UTF-8 PORT="$PORT" pm2 "$@"
}

# `pm2 jlist` is JSON only on a good day: pm2 writes chatter to STDOUT ahead
# of it — `[PM2] Spawning PM2 daemon…` when the daemon was down, `>>>> In-memory
# PM2 is out-of-date` after a pm2 upgrade (node22-bump does one). So the JSON
# is taken from the first line that starts one and parses; anything else is
# reported as unknown (exit 1), never guessed as "not registered" — deploy
# would answer that guess with a second `pm2 start` against a live app.
PM2_JSON='import json, sys
lines = sys.stdin.read().split("\n")
for i, line in enumerate(lines):
    if line[:1] in "[{":
        try:
            procs = json.loads("\n".join(lines[i:]))
        except ValueError:
            continue
        if isinstance(procs, list):
            json.dump(procs, sys.stdout); sys.exit(0)
sys.exit("no parseable JSON in pm2 jlist output")'
pm2_jlist() {   # -> JSON array on stdout; 1 with the reason on stderr
  local jl
  jl="$(pm2_clean jlist 2>/dev/null)" || { echo "pm2 jlist failed" >&2; return 1; }
  printf '%s' "$jl" | python3 -c "$PM2_JSON"
}

# "not registered", "<status>  mode=…", or "unknown (…)" with exit 1.
pm2_state() {
  local js
  js="$(pm2_jlist 2>&1)" || { printf 'unknown (%s)\n' "$js"; return 1; }
  printf '%s' "$js" | python3 -c 'import json, sys
p = [x for x in json.load(sys.stdin) if x.get("name") == sys.argv[1]]
if not p: print("not registered"); raise SystemExit
e = p[0].get("pm2_env", {})
print("%s  mode=%s  restarts=%s  uptime-since=%s" % (
  e.get("status"), e.get("exec_mode"), e.get("restart_time"), e.get("pm_uptime")))' "$APP"
}

# Names of registered processes that are not online (empty = all online);
# exit 1 with the reason when the list cannot be read.
pm2_not_online() {
  local js
  js="$(pm2_jlist 2>&1)" || { printf '%s' "$js"; return 1; }
  printf '%s' "$js" | python3 -c 'import json, sys
print(" ".join(x.get("name", "?") for x in json.load(sys.stdin)
               if x.get("pm2_env", {}).get("status") != "online"))'
}

save_if_online() {
  # pm2 save overwrites the dump with whatever is running right now, so a save
  # while anything is down persists a dump that comes back short on the next
  # reboot. The box rule (lab980 CLAUDE.md) is EVERY app online before a save,
  # not just this one; otherwise say so and leave the previous dump alone.
  local bad
  if ! bad="$(pm2_not_online)"; then
    warn "skipping pm2 save: cannot read the pm2 process list ($bad)"; return 0
  fi
  if [ -n "$bad" ]; then
    warn "not every pm2 process is online ($bad) — skipping pm2 save so the dump keeps its last good state. Run \`pm2 save\` yourself once they are."
    return 0
  fi
  pm2_clean save
}

probe() {
  # Local first, then public: a healthy app behind a broken vhost and a dead
  # app behind a fine vhost look identical from the outside, and telling them
  # apart is most of the diagnosis. Both are printed whatever happens.
  #
  # Pass/fail is the LOCAL port answering HTTP at all — any status code,
  # because an API-only app legitimately 404s on `/` — retried up to
  # PROBE_TRIES times a second apart, since gunicorn is often still booting
  # when pm2 first reports it online. The public side only warns: it also
  # depends on DNS and TLS, which may legitimately not be there yet on a
  # first bring-up.
  local lcode="" pcode i
  for ((i = 1; i <= PROBE_TRIES; i++)); do
    lcode="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "http://127.0.0.1:$PORT/" || true)"
    [ "$lcode" != "000" ] || lcode=""   # curl's code for "never connected"
    [ -z "$lcode" ] || break
    sleep 1
  done
  pcode="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "https://$FQDN/" || true)"
  [ "$pcode" != "000" ] || pcode=""
  printf 'local:     http://127.0.0.1:%s/  ->  HTTP %s\n' "$PORT" "${lcode:-unreachable after $PROBE_TRIES tries}"
  printf 'public:    https://%s/  ->  HTTP %s\n' "$FQDN" "${pcode:-unreachable}"
  [ -n "$lcode" ] || return 1
  case "$pcode" in
    ""|5*) warn "app answers locally but https://$FQDN/ is ${pcode:-unreachable} — look at nginx / DNS / TLS, not the app";;
  esac
}

cmd_deploy() {
  [ $# -eq 0 ] || die "deploy takes no options (see --help)"
  need_root deploy
  command -v pm2 >/dev/null || die "pm2 not found on PATH."
  cd "$ROOT"
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "$ROOT is not a git clone."

  # Decide start-vs-restart BEFORE the sync: a first deploy that cannot start
  # should fail here, not after a hard reset and a pip install it did not need.
  local state
  state="$(pm2_state)" || die "cannot tell whether $APP is registered — $state. Sort pm2 out first (pm2 ls), then deploy again."
  if [ "$state" = "not registered" ] && [ "${START_CMD[0]:-}" = "<entrypoint>" ]; then
    die "$APP is not registered with pm2 and START_CMD in bin/$APP is still the placeholder — set it to the pm2 start target (see the comment above it), land that, then deploy again."
  fi

  local before after
  before="$(git rev-parse --short HEAD)"
  log "Syncing $ROOT to origin/$BRANCH"
  git fetch --quiet origin "$BRANCH"
  git reset --hard --quiet "origin/$BRANCH"
  after="$(git rev-parse --short HEAD)"
  if [ "$before" = "$after" ]; then log "already current ($after)"
  else log "$before -> $after"; git --no-pager log --oneline "$before..$after"; fi

  # The venv lives in the app dir and is gitignored, so it survives the hard
  # reset; requirements.txt pins exact versions, so this is a no-op when
  # nothing changed. pip runs from the same scrubbed environment as pm2: it
  # has no use for anything the calling shell holds.
  command -v python3 >/dev/null || die "python3 not found on PATH."
  if [ ! -x .venv/bin/python ]; then
    log "python3 -m venv .venv"
    python3 -m venv .venv || die "could not create the venv (on Debian/Ubuntu: apt-get install python3-venv)."
  fi
  log "pip install -r requirements.txt"
  env -i PATH="$PATH" HOME="$HOME" LANG=C.UTF-8 \
    .venv/bin/python -m pip install --quiet --disable-pip-version-check -r requirements.txt
  [ -x .venv/bin/gunicorn ] || die "pip ran but .venv/bin/gunicorn is missing — is gunicorn still in requirements.txt?"

  if [ ! -f .env ] || ! grep -q '^ANTHROPIC_API_KEY=.' .env; then
    warn ".env has no ANTHROPIC_API_KEY — the page will load but the droids will have nothing to say. Add it with an editor, then: $APP restart"
  fi

  case "$state" in
    "not registered")
      log "pm2 start ${START_CMD[*]}  ($APP, first registration)"
      pm2_clean start "${START_CMD[@]}"
      state="$(pm2_state)" || die "pm2 start ran but the process list is unreadable — $state"
      [ "$state" != "not registered" ] \
        || die "pm2 start ran but nothing named $APP is registered — START_CMD must name it (--name $APP, or an ecosystem file whose entry is $APP with --only $APP)."
      ;;
    *)
      log "pm2 restart $APP"
      pm2_clean restart "$APP"
      ;;
  esac
  probe || die "$APP is not answering on 127.0.0.1:$PORT — deploy failed, nothing saved. See: $APP logs"
  save_if_online
  log "deployed: $(git rev-parse --short HEAD)  $(git log -1 --format=%s)"
}

cmd_restart() {
  [ $# -eq 0 ] || die "restart takes no options (see --help)"
  need_root restart
  command -v pm2 >/dev/null || die "pm2 not found on PATH."
  local state
  state="$(pm2_state)" || die "cannot tell whether $APP is registered — $state. Sort pm2 out first (pm2 ls), then retry."
  [ "$state" != "not registered" ] || die "$APP is not registered with pm2 — nothing to restart. First start is: $APP deploy"
  log "pm2 restart $APP"
  pm2_clean restart "$APP"
  probe || die "$APP is not answering on 127.0.0.1:$PORT after restart. See: $APP logs"
}
cmd_logs()    { pm2_clean logs "$APP" "$@"; }

cmd_status() {
  cd "$ROOT"
  printf 'checkout:  %s  %s\n' "$(git rev-parse --short HEAD)" "$(git log -1 --format=%s)"
  printf 'pm2:       %s\n' "$(pm2_state || true)"
  probe || true   # status reports, it does not judge — keep going to the cert
  local health
  health="$(curl -s --max-time 10 "http://127.0.0.1:$PORT/api/health" || true)"
  printf 'proxy:     %s\n' "${health:-no answer from /api/health}"
  local pp
  pp="$(curl -sI --max-time 10 "https://$FQDN/" | tr -d '\r' | grep -i '^permissions-policy:' | tail -n 1 || true)"
  case "$pp" in
    *"microphone=(self)"*) printf 'mic:       allowed (%s)\n' "${pp#*: }";;
    "")                    printf 'mic:       no Permissions-Policy header seen on https://%s/\n' "$FQDN";;
    *)                     printf 'mic:       BLOCKED by %s — run: %s mic\n' "${pp#*: }" "$APP";;
  esac
  local pem="/etc/letsencrypt/live/$FQDN/cert.pem"
  if [ -r "$pem" ]; then
    local end days
    end="$(openssl x509 -enddate -noout -in "$pem" | cut -d= -f2)"
    days=$(( ($(date -d "$end" +%s) - $(date +%s)) / 86400 ))
    printf 'cert:      %s days remaining (expires %s)\n' "$days" "$end"
  else
    printf 'cert:      (run as root to read expiry)\n'
  fi
}

# ---------------------------------------------------------------------------
# droids mic — let this vhost use the microphone.
#
# Every lab980 vhost includes snippets/lab980-security-headers.conf, whose
# `Permissions-Policy: camera=(), microphone=(), geolocation=()` switches the
# microphone off for the whole document: getUserMedia fails with the same
# NotAllowedError a user gets for clicking Block, and no prompt ever appears.
# This site is nothing without a microphone, so it needs the one exemption.
#
# Same mechanism as lab980's `fix-security-headers --camera` (which has no
# microphone equivalent): a second Permissions-Policy header. Browsers merge
# the two into one dictionary and the LAST value for a key wins, so the
# override is only effective when its add_header comes AFTER the shared
# snippet's — hence it is inserted directly after every include of that
# snippet, in every context that has one, not once at server level.
#
# Run it after `provision-site` (certbot must already have written the :443
# block) and again after anything that rewrites the vhost. Idempotent.
# ---------------------------------------------------------------------------
mic_snippet_body() {
  cat <<'EOF'
# Droid Talk microphone opt-in — managed by `droids mic`. Included directly
# after snippets/lab980-security-headers.conf in the droids vhost only. The
# last Permissions-Policy value for a key wins, so this must come after the
# shared snippet's microphone=() to override it.
add_header Permissions-Policy "microphone=(self)" always;
EOF
}

# stdin: a vhost. stdout: the same vhost with our include removed everywhere
# and, when $1 is "add", re-inserted after every include of the base snippet
# at that line's own indentation.
mic_rewrite() {
  awk -v mode="$1" -v base="$BASE_INCLUDE" -v ours="${MIC_SNIPPET#/etc/nginx/}" '
    index($0, ours) && $0 ~ /^[ \t]*include[ \t]/ { next }
    { print }
    mode == "add" && index($0, base) && $0 ~ /^[ \t]*include[ \t]/ {
      indent = $0; sub(/[^ \t].*$/, "", indent)
      print indent "include " ours ";  # managed by: droids mic"
    }'
}

cmd_mic() {
  local mode=add dry=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --remove)  mode=remove;;
      --dry-run) dry=1;;
      *) die "unknown mic option: $1 (see --help)";;
    esac
    shift
  done
  local conf="${DROIDS_NGINX_CONF:-/etc/nginx/sites-available/$FQDN}"
  [ -f "$conf" ] || die "$conf not found — provision the site first (see DEPLOY.md)."
  if [ "$mode" = add ] && ! grep -q "$BASE_INCLUDE" "$conf"; then
    die "$conf has no include of $BASE_INCLUDE to anchor the override after. If this vhost sets its own Permissions-Policy, edit that by hand."
  fi
  local new; new="$(mic_rewrite "$mode" < "$conf")"
  if [ "$new" = "$(cat "$conf")" ] && { [ "$mode" = remove ] || [ -f "$MIC_SNIPPET" ]; }; then
    log "nothing to change in $conf"; return 0
  fi
  if [ "$dry" -eq 1 ]; then
    diff -u "$conf" <(printf '%s\n' "$new") || true
    [ "$mode" = remove ] || [ -f "$MIC_SNIPPET" ] || { log "would create $MIC_SNIPPET:"; mic_snippet_body | sed 's/^/    /'; }
    return 0
  fi
  need_root mic
  command -v nginx >/dev/null || die "nginx not found on PATH."
  local backup; backup="/var/backups/droids-vhost-$(date +%Y%m%d-%H%M%S).conf"
  mkdir -p /var/backups && cp -p "$conf" "$backup"
  [ "$mode" = remove ] || { mkdir -p "$(dirname "$MIC_SNIPPET")"; mic_snippet_body > "$MIC_SNIPPET"; }
  printf '%s\n' "$new" > "$conf"
  if ! nginx -t 2>/dev/null; then
    cp -p "$backup" "$conf"
    die "nginx -t rejected the change — $conf restored from $backup, nothing reloaded. Run nginx -t to see why."
  fi
  systemctl reload nginx
  log "nginx reloaded (backup: $backup)"
  local pp
  pp="$(curl -sI --max-time 10 "https://$FQDN/" | tr -d '\r' | grep -i '^permissions-policy:' || true)"
  printf '%s\n' "${pp:-(no Permissions-Policy header seen on https://$FQDN/)}"
  if [ "$mode" = add ]; then
    case "$(printf '%s\n' "$pp" | tail -n 1)" in
      *"microphone=(self)"*) log "microphone allowed on https://$FQDN/";;
      *) warn "the last Permissions-Policy header on https://$FQDN/ is not the override — the microphone is still blocked. Is the :443 block the one that was edited?";;
    esac
  fi
}

case "${1:-}" in
  deploy)  shift; cmd_deploy "$@";;
  restart) shift; cmd_restart "$@";;
  logs)    shift; cmd_logs "$@";;
  status)  shift; cmd_status "$@";;
  mic)     shift; cmd_mic "$@";;
  -h|--help|help|"") usage;;
  *) die "unknown command: $1 (see --help)";;
esac
